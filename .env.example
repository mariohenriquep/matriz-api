# Configuração local da Matriz. Copiar para .env (que não entra no Git) e alterar os valores:
#   cp .env.example .env
# Todos os valores abaixo são fictícios.

# Base de dados (usada pelo docker-compose.yml e pelo backend)
POSTGRES_DB=matriz
POSTGRES_USER=matriz
POSTGRES_PASSWORD=troca-esta-password
POSTGRES_PORTA=5433
MATRIZ_DB_URL=jdbc:postgresql://localhost:5433/matriz

# Backend
MATRIZ_PORTA=8080

# Dados de demonstração: criados no primeiro arranque, se a base de dados não tiver utilizadores.
# Password comum às contas ana@, rui@ e joana@matriz.local.
MATRIZ_SEED_ATIVO=true
MATRIZ_SEED_PASSWORD=demo-matriz-2026
